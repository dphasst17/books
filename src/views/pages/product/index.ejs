<select id="selectYear" class="filterYear h-[30px] bg-gray-800 text-white rounded-md mx-1 my-2 outline-none" onchange="handleFilter()">
  <option value="0">Filter by year</option>
</select>
<select  id="selectSort" class="sort h-[30px] bg-gray-800 text-white rounded-md mx-1 my-2 outline-none"  onchange="handleFilter()">
  <option value="null">Sort by price</option>
  <option value="ASC">Low to high</option>
  <option value="DESC">High to low</option>
</select>
<div id="viewProducts" class="viewsProduct w-[99%] h-auto flex flex-wrap justify-center 3xl:justify-between items-center">
</div>
<div id="viewPagination" class="pagination w-[99%] h-[100px] flex items-center justify-center"></div>
<script>
  fetch('/api/product')
  .then(res => res.json())
  .then(res => {
    viewProduct(res.data)
    viewFilYear(res.filterYear)
    handlePagination(res.countPage,res.pages)
  })

  const viewProduct = (data) => {
    let views = data.map(product => `
    <div
          class="w-[30%] min-w-[180px] lg:w-[25%] 2xl:w-[17%] 3xl:w-[18%] h-auto min-h-[350px] bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 my-2 mx-1"
        >
          <div class="w-full h-2/4 flex items-center justify-center">
            <img
              class="w-3/4 h-3/4 object-contain rounded-t-lg"
              src='${product.imagesBook}''
              alt="product image"
            />
          </div>
          <div class="px-5 pb-5">
              <h5
                class="text-xl font-semibold tracking-tight text-gray-900 dark:text-white overflow-hidden whitespace-nowrap text-ellipsis"
              >
                ${product.name}
              </h5>
              <h4 class="text-md font-semibold tracking-tight text-gray-900 dark:text-white overflow-hidden whitespace-nowrap text-ellipsis">
                Author: <span class="text-lg font-semibold overflow-hidden whitespace-nowrap text-ellipsis">${product.author}</span>
              </h4>
            <div class="flex items-center mt-2.5 mb-5">
              <div class="flex items-center space-x-1 rtl:space-x-reverse">
                <svg
                  class="w-4 h-4 text-yellow-300"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 22 20"
                >
                  <path
                    d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
                  />
                </svg>
                <svg
                  class="w-4 h-4 text-yellow-300"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 22 20"
                >
                  <path
                    d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
                  />
                </svg>
                <svg
                  class="w-4 h-4 text-yellow-300"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 22 20"
                >
                  <path
                    d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
                  />
                </svg>
                <svg
                  class="w-4 h-4 text-yellow-300"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 22 20"
                >
                  <path
                    d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
                  />
                </svg>
                <svg
                  class="w-4 h-4 text-gray-200 dark:text-gray-600"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 22 20"
                >
                  <path
                    d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
                  />
                </svg>
              </div>
              <span
                class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded dark:bg-blue-200 dark:text-blue-800 ms-3"
                >5.0</span
              >
            </div>
            <div class="flex flex-wrap items-center justify-between">
              <span class="w-full text-3xl font-bold text-gray-900 dark:text-white"
                >$${product.price}</span
              >
              <button 
                onclick="window.location.href= '/detail/product/${product.isbn}'"
                class="w-full md:w-[35%] text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-slate-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 my-4"
                >Detail</button>
              <button
                class="w-full md:w-3/5 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 my-4"
                >Add to cart</button>
            </div>
          </div>
        </div>
    
    `).join('')
    document.getElementById('viewProducts').innerHTML = views
  }
  const viewFilYear = (data) => {
    let views = data.map(y => `<option value='${y}'>${y}</option>`).join('')
    document.getElementById('selectYear').innerHTML +=views
  }
  const handlePagination = (data,active) => {
    let arrPages = [];
    for(let i = 1; i <= data;i++){
      arrPages.push(i)
    }
    let viewPage = arrPages.map(p => `<div onclick="fetchNewData(${p})" class='w-[3%] h-1/4 flex items-center justify-center text-white font-semibold cursor-pointer rounded-[5px] ${p === active ? 'bg-blue-900' :'bg-gray-900'} mx-2'>${p}</div>`)
    document.getElementById('viewPagination').innerHTML = viewPage.join('')
  }
  const fetchNewData = (newPages) => {
    const selectSort = document.getElementById('selectSort').value
    let url = selectSort === 'null' ? `/api/product/?pages=${newPages}&limit=15` : `/api/product/?pages=${newPages}&limit=15&sort=true&typeSort=${selectSort}&valueSort=price`
    fetch(url)
    .then(res => res.json())
    .then(res => {
      viewProduct(res.data)
      handlePagination(res.countPage,res.pages)
    })
  }
  const handleFilter = () => {
    const selectValues = document.getElementById('selectYear').value
    const selectSortValue = document.getElementById('selectSort').value
    let url;
    if(selectSortValue === "null" && selectValues === "0"){
      url = `/api/product/?pages=1&limit=15`
    }
    if(selectValues !== '0'){
      url =`/api/product/?pages=1&limit=15&year=${selectValues}` 
    }
    if(selectSortValue !== "null"){
      url =`/api/product/?pages=1&limit=15&sort=true&typeSort=${selectSortValue}&valueSort=price` 
    }
    if(selectSortValue !== "null" && selectValues !== "0"){
      url = `/api/product/?pages=1&limit=15&year=${selectValues}&sort=true&typeSort=${selectSortValue}&valueSort=price`
    }
    fetch(url)
      .then(res => res.json())
      .then(res => {
        console.log(res)
        viewProduct(res.data)
        handlePagination(res.countPage,res.pages)
      })
  }
</script>