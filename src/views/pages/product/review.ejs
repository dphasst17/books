<script>
  fetch('/api/review/detail/<%- idBooks %>')
  .then(res => res.json())
  .then(res => console.log(res.data[0]))
  const vote = (number) => {
    const stars = document.querySelectorAll(".start");
    for (let i = 0; i < number; i++) {
      stars[i].classList.remove("text-gray-500");
      stars[i].classList.add("text-yellow-500");
    }
    for (let i = number; i < stars.length; i++) {
      stars[i].classList.remove("text-yellow-500");
    }
  }
  const submitReview = async(idBooks) => {
    const allStar = document.querySelectorAll(".start.text-yellow-500");
    const value = document.getElementById('review');
    const resultToken = await getToken();
    fetch('/api/review/insert',{
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'Authorization':`Bearer ${resultToken}`
      },
      body:JSON.stringify({idBooks:idBooks,review:value.value,vote:allStar.length})
    })
    .then(res => res.json())
    .then(res => console.log(res))
  };
</script>
