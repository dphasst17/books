<section class="flex items-center bg-gray-100 font-poppins dark:bg-gray-800">
  <div class="container p-4 mx-auto">
    <div id="h-news" class="flex flex-wrap mb-20 -mx-3"></div>
  </div>
</section>
<div
  id="viewPagination"
  class="pagination w-[99%] h-[100px] flex items-center justify-center z-40"
></div>
<script>
  const fetchNewData = (newPages) => {
    let url = `/api/product/?pages=${newPages}&limit=12`;
    fetch(url)
      .then((res) => res.json())
      .then((res) => {
        viewNewProduct(res.data);
        handlePagination(res.countPage, res.pages);
      });
  };
  fetchNewData(1)
  const viewNewProduct = (data) => {
    let viewData = data.map(
      (d) => `<div class="w-full px-3 mb-6 lg:w-1/3 lg:mb-0">
                    <div class="relative w-full h-64 mb-6 bg-center bg-no-repeat bg-cover"
                        style="background-image: url('${d.imagesBook}');">
                        <div class="absolute w-full h-full bg-gray-900 bg-opacity-60"></div>
                        <a class="absolute inset-0 flex items-end">
                            <div class="pb-12 pl-12">
                                <h2 class="mb-2 text-3xl font-bold text-white ">${d.name}</h2>
                                <p class="text-xl font-bold text-white ">
                                    <span>$${d.price}</span>
                                </p>
                            </div>
                        </a>
                    </div>
               </div>`
    );
    document.getElementById("h-news").innerHTML = viewData.join("");
  };
  const handlePagination = (data, active) => {
    let arrPages = [];
    for (let i = 1; i <= data; i++) {
      arrPages.push(i);
    }
    let viewPage = arrPages.map(
      (p) =>
        `<div onclick="fetchNewData(${p})" class='w-[3%] h-1/4 flex items-center justify-center text-white font-semibold cursor-pointer rounded-[5px] ${
          p === active ? "bg-blue-900" : "bg-gray-900"
        } mx-2'>${p}</div>`
    );
    document.getElementById("viewPagination").innerHTML = viewPage.join("");
  };
</script>
